# Base URL of the taxi-app NestJS backend (services/api). Same variable name
# and default as the rider/driver Flutter apps — see
# apps/rider/lib/config/app_config.dart / docs/RUN_LOCAL.md.
API_BASE_URL=http://localhost:3000
