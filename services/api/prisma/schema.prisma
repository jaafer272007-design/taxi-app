// Taxi app — Phase 1 data model.
// Models & enums are reproduced EXACTLY from docs/PHASE1_BUILD_BRIEF.md §2.
// Designed to absorb Phase 2 (system-pooling) without a structural rewrite:
// Trip.createdBy stays DRIVER in Phase 1; SYSTEM + SeatRequest are Phase 2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTE: enum values are one-per-line (valid Prisma syntax). The set of values
// is identical to PHASE1_BUILD_BRIEF.md §2, which listed them compactly.
enum UserRole {
  RIDER
  DRIVER
  ADMIN
}

// Phase 1 amendment: user gender (required to complete a profile via the API).
enum Gender {
  MALE
  FEMALE
}

enum DriverStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum DocType {
  NATIONAL_ID
  DRIVING_LICENSE
  VEHICLE_REG
}

enum DocStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TripStatus {
  OPEN
  LOCKED
  EN_ROUTE
  COMPLETED
  SETTLED
  CANCELLED
}

enum TripCreatedBy {
  DRIVER
  SYSTEM // SYSTEM = Phase 2
}

// Phase 1 amendment: trip audience. WOMEN_FAMILY = نسائية/عائلية (all passengers
// must be female; the driver may be any gender). GENERAL = عامة (no restriction).
enum TripType {
  GENERAL
  WOMEN_FAMILY
}

enum BookingStatus {
  CONFIRMED
  ONBOARD
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH // WALLET/ZAINCASH = Phase 3
}

enum PaymentStatus {
  PENDING
  COLLECTED
}

model User {
  id        String         @id @default(cuid())
  phone     String         @unique // +964...
  name      String?
  gender    Gender? // Phase 1 amendment: required to complete a profile (API-enforced)
  roles     UserRole[]
  driver    DriverProfile?
  createdAt DateTime       @default(now())

  // Phase 1 amendment (السلامة): جهة اتصال للطوارئ — **اختيارية بالكامل**.
  //
  // هذي بيانات **المستخدم عن نفسه**، لا عن مستخدم آخر: رقم قريبه الذي يريد
  // الاتصال به بضغطة واحدة أثناء رحلة جارية. فما في حدّ كشف بين مستخدمَين
  // هنا — لكن **ما يجوز أن تغادر صاحبها أبداً**: لا تُرجَع إلا من
  // `GET /auth/me` للمستخدم نفسه، ولا تظهر بأي حمولة يراها السائق.
  //
  // ليست حقلاً واحداً: بلا اسم يبقى رقم مجرّد على شاشة تُفتح تحت ضغط.
  // كلاهما يُضبط ويُمسح معاً (`AuthService.updateMe`) فما توجد حالة
  // «اسم بلا رقم» التي لا يمكن الاتصال بها.
  emergencyContactName  String?
  emergencyContactPhone String? // +964…، مطبَّع بنفس normalizeIraqiPhone
}

model DriverProfile {
  id              String       @id @default(cuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id])
  status          DriverStatus @default(PENDING)
  rejectionReason String? // set when an admin rejects; cleared on approve (Phase 1 amendment)
  ratingAvg       Float        @default(0)
  tripsDone       Int          @default(0)
  vehicle         Vehicle?
  documents       Document[]
}

model Vehicle {
  id       String        @id @default(cuid())
  driverId String        @unique
  driver   DriverProfile @relation(fields: [driverId], references: [id])
  make     String
  model    String
  plate    String
  color    String
  seats    Int // سعة المقاعد القصوى
}

model Document {
  id         String        @id @default(cuid())
  driverId   String
  driver     DriverProfile @relation(fields: [driverId], references: [id])
  type       DocType
  url        String
  status     DocStatus     @default(PENDING)
  reviewedBy String?
}

// Phase 1 amendment (driver-set pricing): the corridor no longer dictates the
// fare. The admin publishes a SUGGESTED price plus a MIN/MAX band; the driver
// picks the actual price per seat when posting a trip, inside that band. See
// docs/PHASE1_BUILD_BRIEF.md §2 "تسعير يحدده السائق".
// Invariant enforced by CorridorService (create + update):
//   0 < minPricePerSeat <= suggestedPricePerSeat <= maxPricePerSeat
model Corridor {
  id                    String  @id @default(cuid())
  originCity            String // "Najaf"
  destCity              String // "Karbala"
  active                Boolean @default(true)
  suggestedPricePerSeat Int // السعر المعتاد الذي يقترحه الأدمن (IQD)
  minPricePerSeat       Int // أدنى سعر مسموح للسائق (IQD)
  maxPricePerSeat       Int // أعلى سعر مسموح للسائق (IQD)
  trips                 Trip[]
  routeRequests         RouteRequest[] // Phase 1 amendment: إشارة الطلب على هذا الممر
  seatRequests          SeatRequest[] // Phase 2: نيّات الركّاب على هذا الممر
  pools                 Pool[] // Phase 2: التجمّعات المتكوّنة عليه

  // One corridor per directed city pair — the admin can't create a duplicate
  // (Najaf→Karbala twice). Reverse direction is a separate pair, so both remain.
  @@unique([originCity, destCity])
}

model Trip {
  id             String        @id @default(cuid())
  corridorId     String
  corridor       Corridor      @relation(fields: [corridorId], references: [id])
  driverId       String
  vehicleId      String
  departureTime  DateTime
  departNow      Boolean       @default(false)
  seatsTotal     Int
  seatsAvailable Int
  /// Set by the DRIVER at post time, validated into the corridor's
  /// [minPricePerSeat, maxPricePerSeat] band. Snapshotted here, so an admin
  /// re-pricing the corridor later never changes an already-posted trip — or
  /// the fare of a booking already made against it.
  pricePerSeat   Int
  status         TripStatus    @default(OPEN)
  createdBy      TripCreatedBy @default(DRIVER)
  tripType       TripType      @default(GENERAL) // Phase 1 amendment: general vs women/family
  bookings       SeatBooking[]
  createdAt      DateTime      @default(now())
}

model SeatBooking {
  id            String        @id @default(cuid())
  tripId        String
  trip          Trip          @relation(fields: [tripId], references: [id])
  riderId       String
  pickupLat     Float
  pickupLng     Float
  pickupLabel   String
  dropoffLat    Float
  dropoffLng    Float
  dropoffLabel  String
  seatCount     Int           @default(1)
  fare          Int
  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(PENDING)
  status        BookingStatus @default(CONFIRMED)
  createdAt     DateTime      @default(now())
}

model Rating {
  id         String   @id @default(cuid())
  tripId     String
  fromUserId String
  toUserId   String
  score      Int // 1..5
  comment    String?
  createdAt  DateTime @default(now())
}

model EarningsRecord {
  id          String   @id @default(cuid())
  driverId    String
  tripId      String
  amount      Int
  collectedAt DateTime @default(now())
}

// Phase 1 amendment (Step 6): FCM device tokens for push notifications.
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Phase 1 amendment: the IN-APP half of notifications.
///
/// Every event already fires a push (NotificationService.send). Push is blocked
/// on Firebase credentials, so today it only logs — which meant a driver could
/// cancel a trip and the riders found out by arriving at a pickup point for a
/// trip that no longer existed.
///
/// These rows are the second sink for the SAME emitter: one call, one event,
/// persisted here and attempted over FCM. They are what the notification centre
/// reads, and unlike push they work now.
enum NotificationType {
  BOOKING_CREATED /// to the DRIVER: someone booked a seat on your trip
  BOOKING_CONFIRMED /// to the RIDER: your seat is reserved
  BOOKING_CANCELLED_BY_RIDER /// to the DRIVER: a rider pulled out
  BOOKING_CANCELLED /// to the RIDER: your booking is cancelled
  TRIP_STARTED
  TRIP_COMPLETED
  TRIP_CANCELLED /// to the RIDER: the driver cancelled the trip
  DRIVER_APPROVED
  DRIVER_REJECTED
  /// to the RIDER: a driver posted on a corridor they asked us for. راجع RouteRequest.
  ROUTE_AVAILABLE

  // ── Phase 2 (التجميع) ──────────────────────────────────────────────
  /// to the RIDER: سائق استلم تجمّعك وصار عندك حجز مؤكد.
  POOL_CLAIMED
  /// to the RIDER: انتهى التجمّع بلا سائق (أو رسب بعد رفع السعر) — أُطلق طلبك.
  POOL_EXPIRED
  /// to the RIDER: السائق يقترح سعراً أعلى؛ وافق أو ارفض قبل مهلة.
  POOL_RAISE_PROPOSED
  /// to the DRIVER: انتهت مهلة الرفع — كم قبل وكم أُطلق.
  POOL_RAISE_RESOLVED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  /// Arabic, ready to render. Composed at emit time so the centre never has to
  /// re-derive copy from ids that may since have changed.
  title     String
  body      String
  /// Context for deep-linking; nullable because not every event has both.
  tripId    String?
  bookingId String?
  /// Null until the user opens it. Unread count is a COUNT over this.
  readAt    DateTime?
  createdAt DateTime         @default(now())

  /// The centre's only query: this user's rows, newest first.
  @@index([userId, createdAt])
}

// Phase 1 amendment (Step 7): admin accounts.
//
// Admins authenticate with USERNAME + PASSWORD, not phone + WhatsApp OTP, and
// they live in their OWN table — deliberately NOT in `User`. Three reasons:
//
//  1. An admin is not a rider. `User.phone` is the identity key for the whole
//     rider/driver domain; giving admins a synthetic phone row would put
//     non-passengers into every query that reasons about passengers.
//  2. Only this table ever carries a password hash. Keeping it out of `User`
//     means no rider/driver query can accidentally select or leak one.
//  3. OTP is blocked on WhatsApp credentials; admin is a small internal group
//     that needs to work now. The two auth paths stay independent.
//
// Both roles share every operational permission (corridors, driver approval,
// dashboard). SUPER_ADMIN's ONLY extra power is managing admin accounts.
enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

model AdminUser {
  id       String    @id @default(cuid())
  username String    @unique
  /// bcrypt hash. NEVER selected into an API response — see AdminUsersService.
  passwordHash String
  role     AdminRole @default(ADMIN)
  /// Disabled accounts keep their history but cannot log in.
  active   Boolean   @default(true)
  createdAt DateTime @default(now())
  /// AdminUser.id of the super admin who created this account; null for the
  /// env-seeded super admin itself.
  createdBy String?
}

// Phase 1 amendment — عواقب عدم الحضور (no-show).
//
// ليش جدول منفصل و`BookingStatus.NO_SHOW` ما يكفي؟ لسببين، وكلاهما لازم:
//
//  1. **النافذة المتدحرجة.** السياسة «٣ مرات خلال ٣٠ يوماً» تحتاج تاريخاً
//     بتوقيت كل واقعة. حالة الحجز تحمل الواقعة الأخيرة فقط، وتضيع إذا
//     تغيّرت لأي سبب.
//  2. **مسار التظلّم.** الأدمن لازم يقدر يُلغي واقعة واحدة (ظرف طارئ) بلا
//     ما يمسح تاريخ الراكب كله ولا يعبث بحالة حجز محجوز. الإلغاء هنا
//     **ناعم**: الصف يبقى مع سببه ومَن ألغاه — سجل قابل للمراجعة، لا حذف.
//
// الصف يُكتب داخل نفس معاملة تأشير الـ NO_SHOW، فما ينفصل الاثنان أبداً.
model NoShowRecord {
  id        String   @id @default(cuid())
  /// User.id للراكب — بلا relation، مثل بقية الجداول التشغيلية.
  riderId   String
  tripId    String
  /// SeatBooking.id — واحد لكل حجز: فهرس فريد يمنع تسجيل الواقعة مرتين.
  bookingId String   @unique
  /// عدد المقاعد التي تخلّف عنها — للسياق في اللوحة، لا يدخل في العدّ.
  seatCount Int      @default(1)
  createdAt DateTime @default(now())

  /// ── الإلغاء (التظلّم) ─────────────────────────────────────────────
  /// غير فارغ = الواقعة ملغاة ولا تُحتسب في النافذة المتدحرجة.
  voidedAt   DateTime?
  /// AdminUser.id الذي ألغاها.
  voidedBy   String?
  /// سبب الإلغاء — مطلوب عند الإلغاء، ويبقى في السجل.
  voidReason String?

  /// العدّ يسأل دائماً: هذا الراكب، غير ملغاة، ضمن آخر N يوم.
  @@index([riderId, voidedAt, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════
// Phase 2 — Stage 1: التجميع (رحلة يبدأها الراكب)
// ═══════════════════════════════════════════════════════════════════════
//
// Phase 1 اتجاه واحد: السائق يعلن، والراكب يحجز. هذا هو الاتجاه الآخر:
// الراكب يطلب مقعداً على ممرّ داخل نافذة وقت، والنظام يجمّع الطلبات
// المتوافقة، والسائق **يستلم** تجمّعاً جاهزاً من لوحة.
//
// ## ما ليس هنا عمداً
//
// لا موقع لحظي للسائقين، ولا إرسال موجَّه، ولا تتبّع توفّر — لا شيء من ذلك
// موجود في المنتج، وPhase 1 استبعده صراحةً. اكتساب السائق **لوحة يتصفّحها
// ويستلم منها**؛ أول من يستلم يأخذ التجمّع.
//
// ## الضمانة التي لا تُمَسّ
//
// عند الاستلام يصير التجمّع **رحلة عادية** (`Trip.createdBy = SYSTEM`) مع
// `SeatBooking` لكل طلب. من تلك اللحظة تنطبق كل قواعد Phase 1 بلا تعديل:
// معاملة المقعد، آلة الحالة، فان-آوت الإشعارات، عدم الحضور، والإلغاء. لا
// يوجد نظام حجز موازٍ، وهذا شرط لا تنازل عنه.

enum SeatRequestStatus {
  /// ينتظر في تجمّع قيد التكوين.
  PENDING
  /// استُلم التجمّع → صار للراكب حجز حقيقي.
  MATCHED
  /// الراكب ألغى طلبه قبل الاستلام.
  CANCELLED
  /// رفض رفع السعر → أُطلق **بلا أي عقوبة** ولا واقعة عدم حضور.
  DECLINED
  /// انتهت نافذة التجمّع بلا سائق، أو رسب الرفع تحت الحد الأدنى.
  EXPIRED
}

enum PoolStatus {
  /// يقبل طلبات جديدة، ويظهر على اللوحة متى بلغ الحد الأدنى.
  FORMING
  /// سائق استلمه؛ الرحلة موجودة.
  CLAIMED
  /// السائق اقترح رفع السعر؛ ننتظر ردود الركّاب.
  RAISE_PENDING
  /// انتهى بلا سائق، أو رسب الرفع.
  EXPIRED
}

enum RaiseResponse {
  ACCEPTED
  DECLINED
}

enum PoolRaiseOutcome {
  /// قَبِل ما يكفي من المقاعد → الرحلة تمضي بالسعر الجديد.
  ACCEPTED
  /// أقل من الحد الأدنى → التجمّع كله انتهى.
  FAILED
}

/// نيّة الراكب: «أريد مقعداً على هذا الممر داخل هذه النافذة».
///
/// **التزام لا استفسار.** الراكب يرى السعر (`Corridor.suggestedPricePerSeat`)
/// قبل أن يرسل، فهذا الصف يعني «سآخذ مقعداً بهذا السعر». لذلك تُفرض عليه نفس
/// بوّابات الحجز — ملف مكتمل، وغير موقوف لعدم الحضور — **قبل** أي كتابة.
model SeatRequest {
  id         String   @id @default(cuid())
  riderId    String
  corridorId String
  corridor   Corridor @relation(fields: [corridorId], references: [id])

  /// التجمّع الذي انضم إليه. غير فارغ دائماً عملياً: الطلب إمّا ينضم لتجمّع
  /// قائم أو يفتح واحداً جديداً في نفس المعاملة.
  poolId String?
  pool   Pool?   @relation(fields: [poolId], references: [id])

  /// أبكر وأمتع وقت مغادرة يقبله الراكب.
  windowStart DateTime
  windowEnd   DateTime

  seatCount Int @default(1)

  /// door-to-door، بنفس شكل `SeatBooking`. تُنسخ إلى الحجز عند الاستلام.
  pickupLat    Float
  pickupLng    Float
  pickupLabel  String
  dropoffLat   Float
  dropoffLng   Float
  dropoffLabel String

  status SeatRequestStatus @default(PENDING)

  /// `SeatBooking.id` الذي أنشأه الاستلام. بلا FK، مثل `Notification.tripId`.
  bookingId String?

  /// ── ردّ الراكب على رفع السعر ──────────────────────────────────────
  /// يعيش هنا لا في جدول رابع: التجمّع له رفع واحد على الأكثر، والطلب ينتمي
  /// لتجمّع واحد، فالردّ خاصية للطلب. `null` = لم يردّ بعد؛ وعند حسم المهلة
  /// **يُحتسب `null` رفضاً** — الصمت لا يورّط أحداً بسعر لم يوافق عليه.
  raiseResponse    RaiseResponse?
  raiseRespondedAt DateTime?

  createdAt DateTime @default(now())

  /// «طلباتي»، الأحدث أولاً.
  @@index([riderId, status, createdAt])
  /// أعضاء تجمّع معيّن — استعلام الاستلام والحسم.
  @@index([poolId, status])
}

/// مجموعة طلبات متوافقة على ممرّ واحد، جاهزة ليستلمها سائق.
///
/// ## قاعدة التجميع، ويجب أن تبقى قابلة للشرح لراكب
///
/// طلبان يتجمّعان إذا اشتركا في **الممر** و**تقاطعت نافذتاهما**. لا شيء آخر.
/// نافذة التجمّع هي **تقاطع** نوافذ أعضائه، فهي تضيق ولا تتّسع أبداً — أي وقت
/// داخلها يناسب الجميع بالتعريف.
///
/// لا تحسين مسار ولا تقليل انحراف في هذه المرحلة: السائق يرى النقاط ويقرّر.
model Pool {
  id         String   @id @default(cuid())
  corridorId String
  corridor   Corridor @relation(fields: [corridorId], references: [id])

  /// تقاطع نوافذ الأعضاء.
  windowStart DateTime
  windowEnd   DateTime

  /// مجموع مقاعد الأعضاء. مسقوف بأكبر مركبة مدعومة.
  totalSeats Int @default(0)

  /// يبدأ من `Corridor.suggestedPricePerSeat` **منسوخاً** وقت التكوين — بنفس
  /// منطق `Trip.pricePerSeat`: إعادة تسعير الممر لاحقاً لا تغيّر سعراً رآه
  /// راكب والتزم به.
  pricePerSeat Int

  status PoolStatus @default(FORMING)

  /// `DriverProfile.id` — أول من استلم. الحارس على الاستلام هو `updateMany`
  /// مشروط بـ`status = FORMING`، فسائقان في نفس اللحظة ينجح أحدهما فقط.
  claimedByDriverId String?
  claimedAt         DateTime?

  /// الرحلة التي أنشأها الاستلام. بلا FK، مثل بقية المعرّفات التشغيلية.
  tripId String?

  requests SeatRequest[]
  raise    PoolRaise?

  createdAt DateTime @default(now())

  /// اللوحة: تجمّعات هذا الممر القابلة للاستلام.
  @@index([corridorId, status, windowStart])
  /// كنس المنتهية.
  @@index([status, windowEnd])
}

/// اقتراح السائق برفع سعر تجمّع لم يمتلئ.
///
/// **هذا هو المسار الوحيد في التطبيق كله الذي يتغيّر فيه سعر بعد التزام
/// الراكب.** كل شيء آخر يضمن «السعر الذي تراه هو الذي تدفعه»، فهذا الاستثناء
/// مقيَّد من كل جهة:
///
///  - **مرة واحدة لكل تجمّع** — والقيد هو `@unique` على `poolId`، لا حارس
///    بالتطبيق: محاولة ثانية تصطدم بقاعدة البيانات لا بفحص يمكن أن يسبقه سباق.
///  - **مسقوف** بـ`Corridor.maxPricePerSeat`.
///  - **ممنوع داخل مهلة قبل النافذة** — الراكب الذي يرفض يحتاج وقتاً ليدبّر
///    نفسه.
///  - **للراكب مهلة ردّ**، وعدم الردّ رفض.
///  - الرافض يُطلق **بلا عقوبة ولا واقعة عدم حضور**.
///  - وبعد الحسم، السعر لا يتغيّر أبداً مرة أخرى.
model PoolRaise {
  id     String @id @default(cuid())
  /// **القيد هو القاعدة:** رفع واحد لكل تجمّع، مفروض من الفهرس لا من الكود.
  poolId String @unique
  pool   Pool   @relation(fields: [poolId], references: [id])

  /// `DriverProfile.id` للسائق المستلِم — لا يقترح غيره.
  proposedByDriverId String

  oldPricePerSeat Int
  newPricePerSeat Int

  /// آخر لحظة يُقبل فيها ردّ. بعدها يُحسم بالصمت-رفضاً.
  respondBy DateTime

  resolvedAt DateTime?
  outcome    PoolRaiseOutcome?

  createdAt DateTime @default(now())

  /// كنس المهل المستحقّة.
  @@index([resolvedAt, respondBy])
}

/// Phase 1 amendment (طلبات المسارات): راكب يقول «أريد هذا المسار».
///
/// ## ليش موجود
///
/// عندنا ٣٠٦ ممرات والسائقون يعلنون على حفنة منها. الراكب الذي يبحث في مسار
/// بلا عرض يرى حالة فارغة **صحيحة** ثم يغادر — ونحن ما نتعلّم شيئاً. كنا
/// نخمّن أي المسارات تستحق استقطاب سائقين بدل أن يُقال لنا.
///
/// هذا الصف هو الإشارة: طلب واحد = راكب واحد أراد هذا الممر في يوم معيّن.
///
/// ## ليش `SeatRequest` بالـ Phase 2 شيء آخر تماماً
///
/// `SeatRequest` (محجوز للـ Phase 2) هو **طلب مقعد آنيّ** يدخل في مطابقة حية
/// مع سائق. هذا هنا **إشارة طلب سوقيّة**: لا تحجز مقعداً، ولا تلتزم بشيء،
/// ولا تدخل أي مطابقة. لا تبنِ أحدهما على الآخر.
///
/// ## المفتاح الفريد هو قاعدة الـdedupe نفسها
///
/// «طلب واحد لكل راكب لكل ممر في اليوم» **قيدٌ في قاعدة البيانات**، لا
/// قراءة-ثم-كتابة: نقرتان متتاليتان على شبكة عراقية بطيئة تصلان معاً، وأي
/// حارس بالتطبيق يمرّرهما ويضخّم العدّ — والعدّ هو كامل قيمة هذه الميزة.
model RouteRequest {
  id         String   @id @default(cuid())
  /// User.id للراكب — بلا relation، مثل `SeatBooking.riderId`.
  riderId    String
  /// relation حقيقية: التجميع كله على مستوى الممر، وممرّ معلّق يجعل صفّ
  /// اللوحة فارغاً بلا ما يدلّ على السبب.
  corridorId String
  corridor   Corridor @relation(fields: [corridorId], references: [id])

  /// التاريخ/الوقت الذي كان الراكب يبحث عنه، إن حدّده. اختياري لأن البحث
  /// الافتراضي هو «اليوم» بلا نافذة وقت.
  requestedFor DateTime?

  /// يوم التقويم بتوقيت بغداد الذي سُجّل فيه الطلب، كـ DATE.
  /// موجود **حصراً** ليحمل الفهرس الفريد أعلاه — التجميع والانتهاء
  /// يستعملان `createdAt`.
  requestedDay DateTime @db.Date

  createdAt DateTime @default(now())

  /// ── التحقّق (سائق أعلن على هذا الممر) ─────────────────────────────
  /// غير فارغ = أُشعِر الراكب، فلا يُشعَر ثانية بهذا الطلب.
  fulfilledAt       DateTime?
  /// Trip.id الذي حقّق الطلب — بلا FK، مثل `Notification.tripId`.
  ///
  /// ليس للعرض فقط: الفان-آوت **يختم** الصفوف بهذا المعرّف ثم يقرأها به،
  /// وهو ما يجعل «مرة واحدة» صحيحاً حتى لو أعلن سائقان في نفس اللحظة.
  fulfilledByTripId String?

  /// نقرتان في نفس اليوم = صفّ واحد. القيد هو القاعدة.
  @@unique([riderId, corridorId, requestedDay])
  /// سؤال الفان-آوت: طلبات هذا الممر، غير محقّقة، داخل النافذة.
  @@index([corridorId, fulfilledAt, createdAt])
}

/// Phase 1 amendment (أدوات الدعم): سجل تدخّلات الأدمن.
///
/// ## ليش موجود
///
/// اللوحة صارت تقدر **تتصرّف** لا أن تقرأ فقط: تلغي حجزاً نيابةً عن راكب،
/// تلغي رحلة نيابةً عن سائق، توقف سائقاً. هذه أفعال تغيّر مال الناس ورحلاتهم،
/// وقبل هذا كانت تُنفَّذ بكتابة SQL يدوياً — ثلاث مرات أثناء الاختبار — بلا
/// أي أثر يقول مَن فعلها ولا لماذا.
///
/// **السبب مطلوب لا اختياري.** قرار بلا سبب مكتوب لا يمكن مراجعته لاحقاً،
/// ولا يُتعلَّم منه شيء عن أي الحالات كانت أخطاء.
enum AdminActionType {
  BOOKING_CANCELLED   // إلغاء حجز نيابةً عن راكب
  TRIP_CANCELLED      // إلغاء رحلة نيابةً عن سائق
  DRIVER_SUSPENDED
  DRIVER_UNSUSPENDED
  NO_SHOW_VOIDED      // يُسجَّل هنا **وأيضاً** على NoShowRecord نفسه
  NO_SHOW_BLOCK_LIFTED
}

model AdminAction {
  id      String          @id @default(cuid())
  adminId String          // AdminUser.id

  /// اسم المستخدم **منسوخ** وقت الفعل، لا relation.
  ///
  /// مقصود: سجل التدقيق يعيش أطول من الحسابات. صفّ يقول «adm_x9f2 ألغى حجزاً»
  /// بعد حذف الحساب لا ينفع أحداً، والـ join كان سيرجع null بالضبط باللحظة
  /// التي تُراجَع فيها الحادثة.
  adminUsername String

  type AdminActionType

  /// نوع الكيان ومعرّفه — بلا FK عمداً، بنفس منطق `Notification.tripId`:
  /// السجل لازم يبقى مقروءاً حتى لو اختفى صفّه الأصلي.
  entityType String        // 'BOOKING' | 'TRIP' | 'DRIVER' | 'RIDER'
  entityId   String

  reason    String
  createdAt DateTime @default(now())

  /// الفلترتان الوحيدتان اللتان تحتاجهما اللوحة: «شنو سوّى هذا الأدمن» و
  /// «شنو صار لهذا الكيان».
  @@index([adminId, createdAt])
  @@index([entityType, entityId, createdAt])
}
